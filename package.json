{
  "name": "sqlitescope",
  "version": "5.4.0",
  "description": "A friendly desktop SQLite database viewer, editor and manager.",
  "main": "main.js",
  "author": "Sazad Ahemad",
  "license": "MIT",
  "homepage": "https://connect2sazad.github.io/sqlitescope",
  "repository": { "type": "git", "url": "https://github.com/connect2sazad/sqlitescope.git" },
  "bugs": { "url": "https://github.com/connect2sazad/sqlitescope/issues" },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node tests/database.test.js && node tests/workspace.test.js && node tests/converter.test.js",
    "sample": "node scripts/create-sample.js",
    "dist": "npx --yes electron-builder@26.15.3",
    "dist:win": "npx --yes electron-builder@26.15.3 --win nsis portable",
    "dist:linux": "npx --yes electron-builder@26.15.3 --linux AppImage deb"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^43.3.0"
  },
  "build": {
    "appId": "com.lyncdigit.sqlitescope",
    "productName": "SQLiteScope",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "scripts/windows-launch.ps1",
      "build/icon.*",
      "LICENSE",
      "README.md",
      "PRIVACY.md",
      "SECURITY.md",
      "CHANGELOG.md",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SQLiteScope"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
